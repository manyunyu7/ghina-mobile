<?xml version="1.0" encoding="utf-8"?>
<!-- Keep resources referenced only by name from Dart, which R8 resource shrinking
     would otherwise drop: the notification icons (flutter_local_notifications) and
     the launcher shortcut icons (quick_actions, AppShortcut.icon). -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_*,@drawable/ic_shortcut_*" />
