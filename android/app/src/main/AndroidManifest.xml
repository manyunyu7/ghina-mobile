<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Task reminders (flutter_local_notifications). POST_NOTIFICATIONS is a runtime
         permission on Android 13+; RECEIVE_BOOT_COMPLETED lets the plugin re-arm alarms
         after reboot/app update. SCHEDULE_EXACT_ALARM is only used when the user turns on
         "precise reminders" (user-grantable on 14+, we fall back to inexact alarms when it
         is missing). USE_EXACT_ALARM is deliberately NOT declared (Play policy: alarm /
         calendar apps only). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Reminder Sholat uses the same notification permissions (exact alarms whenever the
         user allowed "Alarms & reminders"; inexact otherwise). Location: optional one-shot
         coarse fix when the user picks "Pakai lokasi GPS" (and once per app open after
         that) to calculate prayer times offline; coarse (~km) is plenty for that. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- geolocator_android declares it for its optional location foreground service, which
         Reminder Sholat never starts (one-shot getCurrentPosition only); dropped so Play
         doesn't ask for a foreground-service-location declaration. -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_LOCATION"
        tools:node="remove" />
    <!-- Notes: voice clips (record) and dictation (speech_to_text). Runtime permission,
         requested only when the user taps "Rekam suara" / "Dikte". -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Habits: optional "Kunci Kebiasaan" (local_auth, device biometrics / PIN). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Log Notifikasi (flutter_notification_listener): the listener runs as a plain
         NotificationListenerService bound by the system, never as a foreground
         service (no permanent notification), so the plugin's special-use FGS
         permission is dropped (it would need a Play Console declaration). -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:node="remove" />
    <application
        android:label="Ghina"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- No LAUNCHER filter here: the launcher entry is one of the
                 activity-aliases below (the icon follows the chosen mascot). -->
            <!-- Notes share target (docs/notes.md → Capture paths): text/URL and
                 image(s) shared from other apps become a note. Handled in MainActivity.
                 launchMode singleTask: a share always reaches the ONE running instance
                 (onNewIntent) instead of spawning a second Flutter engine + database
                 inside the sender's task. -->
            <intent-filter android:label="Catatan Ghina">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="Catatan Ghina">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter android:label="Catatan Ghina">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter android:label="Catatan Ghina">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Launcher entries, one per mascot ("Pilih maskot" → LauncherIcon.kt enables the
             chosen one and disables the rest). Exactly one is enabled; the tree is the
             default. The Android 12+ splash shows the launching alias's icon. Each carries
             the static "Chat Killa" shortcut (res/xml/shortcuts.xml). Icons: tool/mascot_icons.sh.
             Keep the names: they are what LauncherIcon.kt and the launcher remember. -->
        <activity-alias
            android:name=".LauncherPohon"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>
        <activity-alias
            android:name=".LauncherAyam"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_ayam"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
